# Traylor Pro Commercial Lead Finder — environment variables
# Copy to .env.local for local development. Never commit real values.

# Data source. Phase 1 supports only "demo" (local, in-browser fictional data).
# "supabase" will be enabled after the dedicated Lead Finder Supabase project is approved.
NEXT_PUBLIC_DATA_SOURCE=demo

# --- Dedicated Lead Finder Supabase project (NOT any existing Traylor Pro project) ---
# Leave blank until the new project is created and approved.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Geocoding (Phase 8) ---
# census (default, free, no key) | mapbox | google
GEOCODER_PROVIDER=census
GEOCODER_API_KEY=
